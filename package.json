{
  "name": "prospect-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @prospect-studio/db --",
    "db:migrate": "turbo run db:migrate -F @prospect-studio/db --",
    "db:push": "turbo run db:push -F @prospect-studio/db --",
    "db:studio": "turbo run db:studio -F @prospect-studio/db --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "test": "node --test packages/api/tests/*.test.mjs packages/db/tests/*.test.mjs"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@prospect-studio/config": "*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "1.23.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
