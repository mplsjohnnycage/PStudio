{
  "name": "@prospect-studio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:dispatcher": "tsx src/private-dispatcher.ts",
    "test": "vitest run tests/unit --no-file-parallelism --maxWorkers=1",
    "test:integration": "vitest run tests/integration --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@prospect-studio/api": "*",
    "@prospect-studio/db": "*",
    "@rivet-dev/pi": "^0.5.6",
    "@rivet-dev/workflows": "1.1.1",
    "rivetkit": "3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prospect-studio/config": "*",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
